# ==========================================
# MONOREPO ENVIRONMENT TEMPLATE (.env.template)
# ==========================================

# ==========================================
# ENTORNO Y RED (GLOBAL)
# ==========================================
NODE_ENV=production # development, production, test
API_HOST=0.0.0.0
API_PORT=8000

# ==========================================
# FRONTEND / DASHBOARD
# ==========================================
# Mapbox public token for map rendering (Baked in at build time as build-arg)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_LANDING_URL=
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_MARKETPLACE_URL=

# ==========================================
# IOT & INGESTOR (Telemetry TCP)
# ==========================================
INGESTOR_HOST=0.0.0.0
INGESTOR_PORT=9000
INGESTOR_SECRET= # (Opcional) Token para endpoints internos del ingestor

# ==========================================
# BASE DE DATOS (PostgreSQL / Prisma)
# ==========================================
DB_HOST=vantx_db # 'vantx_db' para Docker Compose, o localhost/127.0.0.1 para nativo
DB_PORT=5432
DB_NAME=vantx
DB_USER=postgres
DB_PASSWORD=
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:PASSWORD@vantx_db:5432/vantx?schema=public

# ==========================================
# SEGURIDAD Y AUTENTICACIÓN
# ==========================================
# URLs permitidas para conectarse a la API y WebSockets (separadas por coma o una sola)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
# URL base del frontend para construir enlaces de rastreo públicos
FRONTEND_URL=http://localhost:3001

JWT_EXPIRATION=15m # Ej: 15m, 1h, 7d
JWT_SECRET=

ENCRYPTION_ROUNDS=10 # Salt rounds para bcrypt (10 o 12 es estándar)

# ==========================================
# SEEDING / PRIMER DESPLIEGUE
# ==========================================
SUPER_ADMIN_EMAIL=admin@vantx.app
SUPER_ADMIN_PASSWORD=

# ==========================================
# AWS S3 / TEXTRACT (DOCUMENT VALIDATION)
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ==========================================
# DIDIT ID VERIFICATION
# ==========================================
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WORKFLOW_ID_NATIONAL_ID=
DIDIT_WORKFLOW_ID_DRIVERS_LICENSE=

# ==========================================
# Paguelo facil
# ==========================================
PAGUELOFACIL_CCLW=
PAGUELOFACIL_API_URL=

HERE_API_KEY=
