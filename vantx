server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444; # Conexión cerrada sin respuesta (ahorra recursos y confunde bots)
}

# 1. PRIMARY SITE (vantx.app) - Puerto 3000, 3001, 3002, 8000
server {
    server_name vantx.app;

    # Landing page (Port 3000)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Dashboard Application (Port 3001)
    location /dashboard {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Dashboard PWA Service Worker Scope Header
    # Permite al SW controlar todo el origen
    location = /dashboard/sw.js {
        proxy_pass http://127.0.0.1:3001/dashboard/sw.js;
        add_header Service-Worker-Allowed /;
        proxy_set_header Host $host;
    }

    # Marketplace Application (Port 3002)
    location /marketplace {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # REST API Routing (NestJS API Port 8000)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket (Socket.io) Routing Protection
    location /api/socket.io {
        proxy_pass http://127.0.0.1:8000/api/socket.io;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Static Assets Cache (Landing)
    location /_next/static {
        proxy_cache_valid 60m;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Cache-Control "public, max-age=31536000, immutable";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/vantx.app/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/vantx.app/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# Redirect www.vantx.app HTTPS to plain vantx.app
server {
    server_name www.vantx.app;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/vantx.app/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/vantx.app/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    return 301 https://vantx.app$request_uri;
}

