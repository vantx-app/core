# HTTP to HTTPS redirects
server {
    listen 80;
    server_name dashboard.vantx.app;
    return 301 https://vantx.app/dashboard$request_uri;
}

server {
    listen 80;
    server_name vantx.app www.vantx.app;
    return 301 https://vantx.app$request_uri;
}

server {
    listen 80;
    server_name fleet.vantx.app;
    return 301 https://vantx.app/marketplace$request_uri;
}
