# Redirecciones HTTP -> HTTPS
server {
    if ($host = dashboard.vantx.app) {
        return 301 https://$host$request_uri;
    } # managed by Certbot
    listen 80;
    server_name dashboard.vantx.app;
    return 404; # managed by Certbot
}

server {
    listen 80;
    server_name vantx.app www.vantx.app;
    return 301 https://vantx.app$request_uri;
}

server {
    listen 80;
    server_name fleet.vantx.app;
    return 301 https://fleet.vantx.app$request_uri;
}
