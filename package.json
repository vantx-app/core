{
  "name": "vantx-core",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "description": "VantX Fleet Management & Marketplace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:speed-limit": "npm --workspace=@vantx/crm-api run test:speed-limit",
    "backfill:maplinks": "npm --workspace=@vantx/crm-api run backfill:maplinks",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "rxjs": "^7.8.2",
    "turbo": "^2.0.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.17.0"
  }
}
