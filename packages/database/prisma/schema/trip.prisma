model Trip {
  id        String         @id @default(uuid()) @db.Uuid
  vehicleId String         @db.Uuid
  startTime DateTime
  endTime   DateTime?
  
  fuelConsumedLiters Float?
  startFuelLevel     Float?
  endFuelLevel       Float?
  fuelEfficiencyKmL  Float?
  engineHours        Float?
  distanceKm         Float?

  telemetry             TelemetryLog[]
  vehicle               Vehicle                @relation(fields: [vehicleId], references: [id])
  dailyTelemetryRollups DailyTelemetryRollup[]
  polyline              String?                @db.Text

  @@index([vehicleId])
  @@index([startTime])
}
