model Trip {
  id        String         @id @default(uuid()) @db.Uuid
  vehicleId String         @db.Uuid
  startTime DateTime
  endTime   DateTime?
  telemetry TelemetryLog[]
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([startTime])
}
