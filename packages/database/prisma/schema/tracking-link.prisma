model TrackingLink {
  id         String   @id @default(uuid()) @db.Uuid
  vehicleId  String   @db.Uuid
  clientName String?
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([id, isActive])
}
