model VehicleGlobalStats {
  id                     String   @id @default(uuid()) @db.Uuid
  vehicleId              String   @unique @db.Uuid
  totalKm                Float    @default(0)
  totalEngineHours       Float    @default(0)
  globalMaintenanceScore Float    @default(100)
  globalFuelEfficiency   Float    @default(100)
  globalSafetyScore      Float    @default(100)
  globalOverallScore     Float    @default(100)
  lastUpdated            DateTime @updatedAt
  vehicle                Vehicle  @relation(fields: [vehicleId], references: [id])
}
