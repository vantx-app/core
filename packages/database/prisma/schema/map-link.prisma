model MapLink {
  linkId          String   @id
  functionalClass Int
  speedLimit      Int
  geometry        String
  minLat          Float
  maxLat          Float
  minLng          Float
  maxLng          Float
  isBidirectional Boolean  @default(true)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
