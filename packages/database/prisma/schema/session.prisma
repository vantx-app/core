model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  userAgent String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}
