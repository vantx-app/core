model DriverDocument {
  id            String               @id @default(uuid()) @db.Uuid
  driverId      String               @db.Uuid
  type          DriverDocumentType
  status        DriverDocumentStatus @default(PENDING_UPLOAD)
  fileKey       String? // The S3 object key
  fileUrl       String? // Temporary GET URL (for manual review)
  extractedData Json? // Extracted OCR text or key-value fields
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  driver        Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
}
