model Device {
  id            String       @id @default(uuid()) @db.Uuid
  imei          String       @unique
  model         DeviceModel
  status        DeviceStatus @default(UNASSIGNED)
  firmware      String?
  source        DeviceSource @default(FOTA)
  lastSeen      DateTime?
  
  // 1-to-1 relation with Vehicle
  vehicleId     String?      @unique @db.Uuid
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  
  // 1-to-1 relation with SimCard
  simCardId     String?      @unique @db.Uuid
  simCard       SimCard?     @relation(fields: [simCardId], references: [id], onDelete: SetNull)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
